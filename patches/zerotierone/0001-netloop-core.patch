+unsigned int Node::fastProbeRootIpv6AfterNetworkChange(void *tptr,int64_t now,int64_t episodeId,int64_t localSocket,unsigned int *pending)
+{
+	if (pending)
+		*pending = 0;
+#ifdef _WIN32
+	// Only on Windows after the Binder confirms a changed Preferred IPv6.
+	// Every Root has its own three-attempt budget; ACKed Roots are never
+	// probed again within this episode. No changes to ordinary Root timers.
+	if (localSocket <= 0)
+		return 0;
+	{
+		Mutex::Lock _l(_handoverRootHellos_m);
+		if (episodeId != _handoverRootEpisode) {
+			_handoverRootEpisode = episodeId;
+			_handoverRootHellos.clear();
+		}
+	}
+	Hashtable< Address,std::vector<InetAddress> > upstreams;
+	RR->topology->getUpstreamsToContact(upstreams);
+	Hashtable< Address,std::vector<InetAddress> >::Iterator upstream(upstreams);
+	Address *rootAddress = (Address *)0;
+	std::vector<InetAddress> *stable = (std::vector<InetAddress> *)0;
+	unsigned int accepted = 0;
+	for (unsigned int inspected=0;inspected<8 && upstream.next(rootAddress,stable);++inspected) {
+		const SharedPtr<Peer> root(RR->topology->getPeerNoCache(*rootAddress));
+		if (!root || RR->topology->role(*rootAddress) == ZT_PEER_ROLE_LEAF)
+			continue;
+		for (std::vector<InetAddress>::const_iterator ep(stable->begin());ep!=stable->end();++ep) {
+			if (ep->ss_family != AF_INET6 || ep->ipScope() != InetAddress::IP_SCOPE_GLOBAL)
+				continue;
+			unsigned int attempt = 0;
+			{
+				// Only guard the bounded retry accounting. Never hold this
+				// mutex across the topology lookup or wire-send callback.
+				Mutex::Lock _l(_handoverRootHellos_m);
+				HandoverRootHello &probe = _handoverRootHellos[rootAddress->toInt()];
+				attempt = probe.beginAttempt();
+			}
+			if (!attempt)
+				break;
+			uint64_t packetId = 0;
+			const bool submitted = root->sendHELLO(
+				tptr,localSocket,*ep,now,&packetId,true);
+			netloopTrace(tptr,35,rootAddress->toInt(),packetId,
+				8U | (attempt << 8),submitted ? 1 : 0,&*ep);
+			if (submitted)
+				++accepted;
+			break; // at most one HELLO for a Root during this attempt
+		}
+	}
+	if (pending) {
+		Mutex::Lock _l(_handoverRootHellos_m);
+		for (std::map<uint64_t,HandoverRootHello>::const_iterator i(_handoverRootHellos.begin());
+			i != _handoverRootHellos.end();++i) {
+			if (i->second.pending())
+				++*pending;
+		}
+	}
+	return accepted;
+#else
+	(void)tptr;
+	(void)now;
+	(void)episodeId;
+	(void)localSocket;
+	return 0;
+#endif
+}
+
+void Node::registerHandoverRootHelloPacket(const Address &peer,uint64_t packetId)
+{
+#ifdef _WIN32
+	Mutex::Lock _l(_handoverRootHellos_m);
+	std::map<uint64_t,HandoverRootHello>::iterator i(_handoverRootHellos.find(peer.toInt()));
+	if (i != _handoverRootHellos.end())
+		i->second.registerPacket(packetId);
+#else
+	(void)peer;
+	(void)packetId;
+#endif
+}
+
+void Node::authenticatedHandoverRootHello(const Address &peer,uint64_t packetId,const InetAddress &source,void *tptr)
+{
+#ifdef _WIN32
+	if (source.ss_family != AF_INET6)
+		return;
+	bool authenticated = false;
+	{
+		Mutex::Lock _l(_handoverRootHellos_m);
+		std::map<uint64_t,HandoverRootHello>::iterator i(_handoverRootHellos.find(peer.toInt()));
+		if (i != _handoverRootHellos.end())
+			authenticated = i->second.acknowledge(packetId);
+	}
+	if (authenticated)
+		netloopTrace(tptr,38,peer.toInt(),packetId,8U,1,&source);
+#else
+	(void)peer;
+	(void)packetId;
+	(void)source;
+	(void)tptr;
+#endif
+}
+
+unsigned int Node::revalidatePeerPathsAfterNetworkChange(void *tptr,int64_t now)
+{
+#ifdef _WIN32
+	// Read-only snapshot of the Root/Planet HELLO scheduler immediately after
+	// Binder rebind. Do not reset upstream paths or send any extra packets.
+	// The ordinary background scheduler may be waiting to check peers at all.
+	const int64_t pingPeriod = (int64_t)ZT_PING_CHECK_INTERVAL * (_lowBandwidthMode ? 5 : 1);
+	const int64_t pingWait = pingPeriod - (now - _lastPingCheck);
+	netloopTrace(tptr,32,0,(uint64_t)_lastPingCheck,
+		_lowBandwidthMode ? 1U : 0U,
+		(int)((pingWait > 0) ? (pingWait > 2147483647LL ? 2147483647LL : pingWait) : 0));
+
+	// Inspect exactly the same designated Root/Moon stable endpoints and
+	// last-full-HELLO timer that _PingPeersThatNeedPing consults. One sample
+	// per IP family per Root (up to eight roots) bounds native log volume.
+	Hashtable< Address,std::vector<InetAddress> > upstreams;
+	RR->topology->getUpstreamsToContact(upstreams);
+	Hashtable< Address,std::vector<InetAddress> >::Iterator upstream(upstreams);
+	Address *rootAddress = (Address *)0;
+	std::vector<InetAddress> *stable = (std::vector<InetAddress> *)0;
+	for (unsigned int logged=0;logged<8 && upstream.next(rootAddress,stable);++logged) {
+		const SharedPtr<Peer> root(RR->topology->getPeerNoCache(*rootAddress));
+		const bool hasPath = root && !root->paths(now).empty();
+		const bool roleIsLeaf = RR->topology->role(*rootAddress) == ZT_PEER_ROLE_LEAF;
+		const int scale = roleIsLeaf ? 2 : (hasPath ? 16 : 0);
+		const int64_t lastHello = root ? root->lastSentFullHello() : 0;
+		const int64_t delay = (int64_t)ZT_PATH_HEARTBEAT_PERIOD * scale - (now - lastHello);
+		const bool gated = root && delay >= 0; // matches the background scheduler's <= test
+		const int waitMs = (!root) ? -1 :
+			((delay > 0) ? (int)(delay > 2147483647LL ? 2147483647LL : delay) : 0);
+		const unsigned int commonFlags = (root ? 1U : 0U)
+			| (hasPath ? 2U : 0U)
+			| (gated ? 4U : 0U)
+			| (roleIsLeaf ? 32U : 0U);
+		bool seenV4 = false;
+		bool seenV6 = false;
+		for (std::vector<InetAddress>::const_iterator ep(stable->begin());ep!=stable->end();++ep) {
+			if (ep->ss_family == AF_INET && !seenV4) {
+				seenV4 = true;
+				netloopTrace(tptr,33,rootAddress->toInt(),(uint64_t)lastHello,
+					commonFlags | 16U,waitMs,&*ep);
+			} else if (ep->ss_family == AF_INET6 && !seenV6) {
+				seenV6 = true;
+				netloopTrace(tptr,33,rootAddress->toInt(),(uint64_t)lastHello,
+					commonFlags | 8U,waitMs,&*ep);
+			}
+			if (seenV4 && seenV6)
+				break;
+		}
+		// Emit missing-family decisions explicitly, rather than interpreting
+		// silence as a missing IPv6 candidate (a truncated trace is different).
+		if (!seenV4)
+			netloopTrace(tptr,33,rootAddress->toInt(),(uint64_t)lastHello,
+				commonFlags | 16U | 64U,-2);
+		if (!seenV6)
+			netloopTrace(tptr,33,rootAddress->toInt(),(uint64_t)lastHello,
+				commonFlags | 8U | 64U,-2);
+	}
+#endif
+
+	// Snapshot peer references before sending probes: the send callback and
+	// WHOIS may acquire Topology locks. Prioritize most recently heard peers.
+	std::vector< std::pair< Address,SharedPtr<Peer> > > peers(RR->topology->allPeers());
+	std::sort(peers.begin(),peers.end(),
+		[](const std::pair< Address,SharedPtr<Peer> > &a,
+		   const std::pair< Address,SharedPtr<Peer> > &b) {
+			return a.second->lastReceive() > b.second->lastReceive();
+		});
+	unsigned int scheduled = 0;
+	for (std::vector< std::pair< Address,SharedPtr<Peer> > >::const_iterator p(peers.begin());
+		 p!=peers.end() && scheduled < 32;++p) {
+		if (RR->topology->isUpstream(p->second->identity()) || p->second->paths(now).empty())
+			continue;
+		// Do not use isActive(): SDK builds expire its activity flag after 30s,
+		// while a broken peer can have been unreachable for several minutes.
