diff --git a/node/NetloopHandoverPolicy.hpp b/node/NetloopHandoverPolicy.hpp
new file mode 100644
index 0000000..5aedf43
--- /dev/null
+++ b/node/NetloopHandoverPolicy.hpp
@@ -0,0 +1,126 @@
+/*
+ * NetLoop's private handover send/retry policy. Kept independent of sockets,
+ * Windows IP Helper and Node locks so the exact decisions can be unit tested.
+ */
+#ifndef ZT_NETLOOP_HANDOVER_POLICY_HPP
+#define ZT_NETLOOP_HANDOVER_POLICY_HPP
+
+#include <stdint.h>
+
+namespace ZeroTier {
+namespace NetloopHandoverPolicy {
+
+// A private tag on the Core->libzt wire callback's localSocket argument.
+// Only fast handover Root HELLOs use it. Windows user-mode pointers never
+// occupy bit 62. Normal socket IDs (including -1) remain unchanged.
+static const uint64_t STRICT_ROOT_SOCKET_FLAG = 0x4000000000000000ULL;
+
+inline int64_t markStrictRootSocket(int64_t socket)
+{
+#ifdef _WIN32
+    if (socket <= 0 || (static_cast<uint64_t>(socket) & STRICT_ROOT_SOCKET_FLAG))
+        return -1;
+    return static_cast<int64_t>(
+        static_cast<uint64_t>(socket) | STRICT_ROOT_SOCKET_FLAG);
+#else
+    return socket;
+#endif
+}
+
+inline bool isStrictRootSocket(int64_t token)
+{
+#ifdef _WIN32
+    return token > 0 &&
+        (static_cast<uint64_t>(token) & STRICT_ROOT_SOCKET_FLAG) != 0;
+#else
+    (void)token;
+    return false;
+#endif
+}
+
+inline int64_t physicalSocket(int64_t token)
+{
+    return isStrictRootSocket(token)
+        ? static_cast<int64_t>(
+            static_cast<uint64_t>(token) & ~STRICT_ROOT_SOCKET_FLAG)
+        : token;
+}
+
+enum UdpSendMode {
+    SEND_SPECIFIED_SOCKET,
+    FALLBACK_TO_BINDER,
+    REJECT_STALE_ROOT_SOCKET
+};
+
+inline UdpSendMode udpSendMode(int64_t token, bool boundSocketValid)
+{
+    if (boundSocketValid)
+        return SEND_SPECIFIED_SOCKET;
+    return isStrictRootSocket(token)
+        ? REJECT_STALE_ROOT_SOCKET : FALLBACK_TO_BINDER;
+}
+
+// A temporary DAD/IP Helper error does not spend one of three Root HELLO
+// sends. Never retry beyond the bounded 30-second episode window.
+enum RootRetryMode {
+    ROOT_RETRY_STOP,
+    ROOT_RETRY_DEFER,
+    ROOT_RETRY_SEND
+};
+
+inline RootRetryMode rootRetryMode(
+    unsigned int attempts, int64_t startedAt, int64_t now,
+    bool dadPreferred, bool socketMatchesPreferredInterface)
+{
+    if (attempts >= 3 || now < startedAt || now - startedAt >= 30000)
+        return ROOT_RETRY_STOP;
+    if (!dadPreferred || !socketMatchesPreferredInterface)
+        return ROOT_RETRY_DEFER;
+    return ROOT_RETRY_SEND;
+}
+
+// Packet IDs are registered before the synchronous send callback to avoid
+// missing a very fast authenticated reply. The owner map is keyed by Root ID.
+struct RootHelloAttemptState {
+    uint64_t packetIds[3];
+    unsigned int attempts;
+    bool authenticated;
+
+    RootHelloAttemptState() : attempts(0), authenticated(false)
+    {
+        packetIds[0] = packetIds[1] = packetIds[2] = 0;
+    }
+
+    unsigned int beginAttempt()
+    {
+        if (authenticated || attempts >= 3)
+            return 0;
+        return ++attempts;
+    }
+
+    void registerPacket(uint64_t packetId)
+    {
+        if (!authenticated && attempts && attempts <= 3)
+            packetIds[attempts - 1] = packetId;
+    }
+
+    bool acknowledge(uint64_t packetId)
+    {
+        if (!packetId || authenticated)
+            return false;
+        for (unsigned int i = 0; i < attempts; ++i) {
+            if (packetIds[i] && packetIds[i] == packetId) {
+                authenticated = true;
+                return true;
+            }
+        }
+        return false;
+    }
+
+    bool pending() const { return !authenticated && attempts < 3; }
+};
+
+} // namespace NetloopHandoverPolicy
+} // namespace ZeroTier
+
+#endif
