+unsigned int Node::fastProbeRootIpv6AfterNetworkChange(void *tptr,int64_t now)
+{
+#ifdef _WIN32
+	// No change to normal 224-second scheduling or memorized upstream paths.
+	// libzt only invokes this after a newly bound global IPv6 address during
+	// a confirmed OS handover, once per handover episode.
+	Hashtable< Address,std::vector<InetAddress> > upstreams;
+	RR->topology->getUpstreamsToContact(upstreams);
+	Hashtable< Address,std::vector<InetAddress> >::Iterator upstream(upstreams);
+	Address *rootAddress = (Address *)0;
+	std::vector<InetAddress> *stable = (std::vector<InetAddress> *)0;
+	unsigned int sent = 0;
+	for (unsigned int inspected=0;inspected<8 && upstream.next(rootAddress,stable);++inspected) {
+		const SharedPtr<Peer> root(RR->topology->getPeerNoCache(*rootAddress));
+		if (!root || RR->topology->role(*rootAddress) == ZT_PEER_ROLE_LEAF)
+			continue;
+		for (std::vector<InetAddress>::const_iterator ep(stable->begin());ep!=stable->end();++ep) {
+			if (ep->ss_family != AF_INET6 || ep->ipScope() != InetAddress::IP_SCOPE_GLOBAL)
+				continue;
+			// The same HELLO primitive used by the existing Root scheduler;
+			// no path invalidation, extra retransmit loop or altered timers.
+			root->sendHELLO(tptr,-1,*ep,now);
+			netloopTrace(tptr,35,rootAddress->toInt(),(uint64_t)now,8U,1,&*ep);
+			++sent;
+			break; // one IPv6 HELLO per known Root per episode
+		}
+	}
+	return sent;
+#else
+	(void)tptr;
+	(void)now;
+	return 0;
+#endif
+}
