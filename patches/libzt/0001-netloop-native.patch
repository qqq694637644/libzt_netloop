+        return ZTS_ERR_ARG;
+    memset(dst, 0, len);
+    const int result = getAddrAtIdx(net_id, idx, dst, len);
+    if (result != ZTS_ERR_OK)
+        return result;
+    const struct sockaddr* sa = (const struct sockaddr*)&n->second.config.assignedAddresses[idx];
+    unsigned int prefix = 0;
+    if (sa->sa_family == AF_INET)
+        prefix = Utils::ntoh(((const struct sockaddr_in*)sa)->sin_port);
+    else if (sa->sa_family == AF_INET6)
+        prefix = Utils::ntoh(((const struct sockaddr_in6*)sa)->sin6_port);
+    else
+        return ZTS_ERR_ARG;
+    if (prefix > (sa->sa_family == AF_INET ? 32u : 128u))
+        return ZTS_ERR_ARG;
+    const size_t offset = strlen(dst);
+    snprintf(dst + offset, len - offset, "/%u", prefix);
+    return ZTS_ERR_OK;
+}
