 namespace ZeroTier {
 
+#ifdef _WIN32
+// The Binder's successful bind is not proof Windows has completed IPv6 DAD.
+// Check only the newly bound global IPv6 IPs (not old still-preferred IPs).
+// IpDadStatePreferred and SkipAsSource are supplied by Windows IP Helper.
+// A negative result means the query failed; zero means no matching address.
+static int netloopPreferredIpv6DadState(const std::vector<InetAddress> &newBoundIps)
+{
+    PMIB_UNICASTIPADDRESS_TABLE table = (PMIB_UNICASTIPADDRESS_TABLE)0;
+    const DWORD error = GetUnicastIpAddressTable(AF_INET6, &table);
+    if (error != NO_ERROR || !table)
+        return error ? -((int)error) : -1;
+
+    int result = 0;
+    for (unsigned int n=0;n<table->NumEntries;++n) {
+        const MIB_UNICASTIPADDRESS_ROW &row = table->Table[n];
+        if (row.Address.si_family != AF_INET6)
+            continue;
+        for (std::vector<InetAddress>::const_iterator ip(newBoundIps.begin());ip!=newBoundIps.end();++ip) {
+            if (memcmp(row.Address.Ipv6.sin6_addr.s6_addr,ip->rawIpData(),16) != 0)
+                continue;
+            if (row.DadState == IpDadStatePreferred && !row.SkipAsSource) {
+                FreeMibTable(table);
+                return (int)IpDadStatePreferred;
+            }
+            result = row.SkipAsSource ? 5 : (int)row.DadState;
+        }
+    }
+    FreeMibTable(table);
+    return result;
+}
+#endif
