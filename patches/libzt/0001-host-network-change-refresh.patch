+void NodeService::networkChanged()
+{
+    {
+        Mutex::Lock _l(_run_m);
+        if (! _run) {
+            return;
+        }
+        _networkChangeRequested = true;
+        _nextBackgroundTaskDeadline = 0;
+    }
+    _phy.whack();
