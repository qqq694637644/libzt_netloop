diff --git a/src/NodeService.cpp b/src/NodeService.cpp
index f622755..b5af702 100644
--- a/src/NodeService.cpp
+++ b/src/NodeService.cpp
@@ -369,8 +369,35 @@ void NodeService::nodeNetLoopCoreTrace(
 {
     // Distinct event namespace from unverified socket-level wire headers.
     // No encrypted packet content crosses this callback.
-    if (kind >= 10 && kind <= 17)
-        recordUnderlay(kind, peerId, reference, flags, 0, result, endpoint);
+    if (kind < 10 || kind > 29)
+        return;
+
+    if (kind == 26 || kind == 27) {
+        std::string routeKey = std::to_string(flags);
+        if (endpoint) {
+            char addr[64] = { 0 };
+            reinterpret_cast<const InetAddress*>(endpoint)->toString(addr);
+            routeKey.append("|");
+            routeKey.append(addr);
+        }
+        const int64_t now = OSUtils::now();
+        {
+            Mutex::Lock _l(_underlayTrace_m);
+            const uint64_t sampleKey = (peerId << 6) | kind;
+            const int64_t interval = kind == 26 ? 5000 : 15000;
+            std::map<uint64_t, std::pair<int64_t, std::string> >::iterator previous =
+                _underlayRouteSamples.find(sampleKey);
+            if (previous != _underlayRouteSamples.end()
+                && previous->second.second == routeKey
+                && (now - previous->second.first) < interval)
+                return;
+            if (previous == _underlayRouteSamples.end()
+                && _underlayRouteSamples.size() >= 64)
+                _underlayRouteSamples.clear();
+            _underlayRouteSamples[sampleKey] = std::make_pair(now, routeKey);
+        }
+    }
+    recordUnderlay(kind, peerId, reference, flags, 0, result, endpoint);
 }
 
