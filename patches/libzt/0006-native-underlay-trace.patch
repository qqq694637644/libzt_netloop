+// Only the unencrypted ZeroTier header is inspected. Packet IDs and source/
+// destination Node IDs are not authenticated by this trace and must not be
+// treated as verified application or Peer control-plane messages.
+static uint64_t netloopReadWireInteger(const unsigned char* bytes, unsigned int count)
+{
+    uint64_t value = 0;
+    for (unsigned int i = 0; i < count; ++i)
+        value = (value << 8) | bytes[i];
+    return value;
+}
+
+void NodeService::recordUnderlay(
+    uint32_t kind, uint64_t peerId, uint64_t reference, uint32_t flags,
+    uint32_t byteCount, int32_t result, const struct sockaddr_storage* endpoint,
+    uint16_t previousSecondary)
+{
+    zts_netloop_underlay_event_t event = {};
+    event.timestamp_ms = OSUtils::now();
+    event.peer_id = peerId;
+    event.reference = reference;
+    event.kind = kind;
+    event.flags = flags;
+    event.byte_count = byteCount;
+    event.result = result;
+    const unsigned int ports = _boundUdpPortSnapshot.load(std::memory_order_acquire);
+    event.primary_port = static_cast<uint16_t>(ports >> 16);
+    event.secondary_port = static_cast<uint16_t>(ports & 0xffff);
+    event.previous_secondary_port = previousSecondary;
+    if (endpoint)
+        reinterpret_cast<const InetAddress*>(endpoint)->toString(event.endpoint);
+
+    Mutex::Lock _l(_underlayTrace_m);
+    if (_underlayTrace.size() == 512) {
+        _underlayTrace.pop_front();
+        ++_underlayTraceDropped;
+    }
+    _underlayTrace.push_back(event);
+}
+
+int NodeService::pollUnderlayEvent(
+    zts_netloop_underlay_event_t* event, uint64_t* droppedTotal)
+{
+    Mutex::Lock _l(_underlayTrace_m);
+    *droppedTotal = _underlayTraceDropped;
+    if (_underlayTrace.empty())
+        return 0;
+    *event = _underlayTrace.front();
+    _underlayTrace.pop_front();
+    return 1;
+}
+
+void NodeService::traceUnderlayWire(
+    uint32_t kind, const struct sockaddr_storage* endpoint,
+    const void* data, unsigned int len, int32_t result)
+{
+    // Skip ZeroTier fragment headers and malformed/short packets. These are
+    // observations at the physical socket boundary, before authentication.
+    if (!data || !endpoint || len < 28)
+        return;
+    const unsigned char* bytes = static_cast<const unsigned char*>(data);
+    if (bytes[13] == 0xff)
+        return;
+    const uint64_t peer = netloopReadWireInteger(bytes + (kind == 5 ? 8 : 13), 5);
+    if (!peer)
+        return;
+
+    char remote[64] = { 0 };
+    reinterpret_cast<const InetAddress*>(endpoint)->toString(remote);
+    const int64_t now = OSUtils::now();
+    bool logPacket = false;
+    {
+        Mutex::Lock _l(_underlayTrace_m);
+        const uint64_t key = (peer << 1) | (kind == 6 ? 1 : 0);
+        std::map<uint64_t, std::pair<int64_t, std::string> >::iterator last =
+            _underlayWireSamples.find(key);
+        if (last == _underlayWireSamples.end()
+            || last->second.second != remote
+            || now - last->second.first >= 1000
+            || result < 0) {
+            if (last == _underlayWireSamples.end() && _underlayWireSamples.size() >= 64)
+                _underlayWireSamples.clear();
+            _underlayWireSamples[key] = std::make_pair(now, std::string(remote));
+            logPacket = true;
+        }
+    }
+    if (logPacket) {
+        recordUnderlay(
+            kind, peer, netloopReadWireInteger(bytes, 8),
+            bytes[18], len, result, endpoint);
+    }
+}
+
+void NodeService::tracePlanetSnapshot()
+{
+    ZT_PeerList* const peers = _node->peers();
+    unsigned int roots = 0;
+    if (peers) {
+        for (unsigned long i = 0; i < peers->peerCount && roots < 8; ++i) {
+            const ZT_Peer& peer = peers->peers[i];
+            if (peer.role != ZT_PEER_ROLE_PLANET)
+                continue;
+            ++roots;
+            uint64_t newestReceive = 0;
+            const struct sockaddr_storage* newestPath = 0;
+            for (unsigned int p = 0; p < peer.pathCount && p < ZTS_MAX_PEER_NETWORK_PATHS; ++p) {
+                if (peer.paths[p].lastReceive >= newestReceive) {
+                    newestReceive = peer.paths[p].lastReceive;
+                    newestPath = &peer.paths[p].address;
+                }
+            }
+            recordUnderlay(
+                8, peer.address, newestReceive, peer.pathCount, 0,
+                _node->online() ? 1 : 0, newestPath);
+        }
+        _node->freeQueryResult((void*)peers);
+    }
+    if (!roots)
+        recordUnderlay(8, 0, 0, 0, 0, _node->online() ? 1 : 0);
+}
