+/**
+ * NetLoop read-only underlay trace. Version 1, fixed 112-byte ABI layout.
+ * Kinds: 1=network-refresh-queued, 2=binder-start, 3=binder-complete,
+ * 4=path-check, 5=wire-tx, 6=wire-rx, 7=node-phase, 8=planet-snapshot.
+ *
+ * UDP wire IDs are unverified header observations, NOT authenticated peer
+ * identity or decoded protocol verbs. No packet contents are retained.
+ * Returns 1 if an event was read, 0 if empty, negative ZTS_ERR_* on error.
+ * dropped_total is cumulative and also populated when the queue is empty.
+ */
+typedef struct zts_netloop_underlay_event {
+    int64_t timestamp_ms;
+    uint64_t peer_id;
+    uint64_t reference;
+    uint32_t kind;
+    uint32_t flags;
+    uint32_t byte_count;
+    int32_t result;
+    uint16_t primary_port;
+    uint16_t secondary_port;
+    uint16_t previous_secondary_port;
+    uint16_t reserved;
+    char endpoint[64];
+} zts_netloop_underlay_event_t;
+ZTS_API int ZTCALL zts_netloop_poll_underlay_event(
+    zts_netloop_underlay_event_t* event, uint64_t* dropped_total);
+
