+int zts_netloop_get_bound_udp_ports(uint16_t* primary, uint16_t* secondary)
+{
+    if (!primary || !secondary)
+        return ZTS_ERR_ARG;
+    ACQUIRE_SERVICE(ZTS_ERR_SERVICE);
+    zts_service->getBoundUdpPorts(primary, secondary);
+    return ZTS_ERR_OK;
+}
