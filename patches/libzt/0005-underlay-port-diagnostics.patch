diff --git a/src/NodeService.cpp b/src/NodeService.cpp
index 32a11c7..3925158 100644
--- a/src/NodeService.cpp
+++ b/src/NodeService.cpp
@@ -421,6 +421,22 @@ NodeService::ReasonForTermination NodeService::run()
                     _binder.refresh(_phy, p, pc, explicitBind, *this);
                 }
 
+                // Observe the binder itself: _secondaryPort stays zero for
+                // dynamic rotation and cannot describe the real UDP binding.
+                unsigned int primaryBound = 0;
+                unsigned int secondaryBound = 0;
+                std::vector<InetAddress> bound(_binder.allBoundLocalInterfaceAddresses());
+                for (std::vector<InetAddress>::const_iterator i(bound.begin()); i != bound.end(); ++i) {
+                    const unsigned int port = i->port();
+                    if (port == _ports[0])
+                        primaryBound = port;
+                    if (_ports[1] && port == _ports[1])
+                        secondaryBound = port;
+                }
+                _boundUdpPortSnapshot.store(
+                    ((primaryBound & 0xffff) << 16) | (secondaryBound & 0xffff),
+                    std::memory_order_release);
+
                 // Keep the core's view of local physical interfaces in sync
                 // with the freshly rebound sockets. This mirrors ZeroTierOne
                 // 1.12's faster physical-network-change recovery.
@@ -2217,6 +2233,14 @@ unsigned short NodeService::getPrimaryPort() const
     return _primaryPort;
 }
 
+void NodeService::getBoundUdpPorts(
+    unsigned short* primary, unsigned short* secondary) const
+{
+    const unsigned int ports = _boundUdpPortSnapshot.load(std::memory_order_acquire);
+    *primary = (unsigned short)((ports >> 16) & 0xffff);
+    *secondary = (unsigned short)(ports & 0xffff);
+}
