--- a/src/NodeService.cpp
+++ b/src/NodeService.cpp
@@ -1306,6 +1306,34 @@ int NodeService::getAddrAtIdx(uint64_t net_id, unsigned int idx, char* dst, unsi
     return ZTS_ERR_OK;
 }
 
+int NodeService::getAddrCidrAtIdx(uint64_t net_id, unsigned int idx, char* dst, unsigned int len)
+{
+    if (!dst || len < ZTS_IP_MAX_STR_LEN + 5)
+        return ZTS_ERR_ARG;
+    std::map<uint64_t, NetworkState>::const_iterator n(_nets.find(net_id));
+    if (n == _nets.end())
+        return ZTS_ERR_NO_RESULT;
+    if (idx >= n->second.config.assignedAddressCount)
+        return ZTS_ERR_ARG;
+    memset(dst, 0, len);
+    const int result = getAddrAtIdx(net_id, idx, dst, len);
+    if (result != ZTS_ERR_OK)
+        return result;
+    const struct sockaddr* sa = (const struct sockaddr*)&n->second.config.assignedAddresses[idx];
+    unsigned int prefix = 0;
+    if (sa->sa_family == AF_INET)
+        prefix = Utils::ntoh(((const struct sockaddr_in*)sa)->sin_port);
+    else if (sa->sa_family == AF_INET6)
+        prefix = Utils::ntoh(((const struct sockaddr_in6*)sa)->sin6_port);
+    else
+        return ZTS_ERR_ARG;
+    if (prefix > (sa->sa_family == AF_INET ? 32u : 128u))
+        return ZTS_ERR_ARG;
+    const size_t offset = strlen(dst);
+    snprintf(dst + offset, len - offset, "/%u", prefix);
+    return ZTS_ERR_OK;
+}
