 }
 
+int NodeService::getRouteCidrAtIdx(
+    uint64_t net_id, unsigned int idx, char* target, char* via,
+    unsigned int len, uint16_t* flags, uint16_t* metric)
+{
+    if (!target || !via || !flags || !metric || len < ZTS_IP_MAX_STR_LEN + 5)
+        return ZTS_ERR_ARG;
+    std::map<uint64_t, NetworkState>::const_iterator n(_nets.find(net_id));
+    if (n == _nets.end())
+        return ZTS_ERR_NO_RESULT;
+    if (idx >= n->second.config.routeCount)
+        return ZTS_ERR_ARG;
+    const int result = getRouteAtIdx(net_id, idx, target, via, len, flags, metric);
+    if (result != ZTS_ERR_OK)
+        return result;
+    const struct sockaddr* sa = (const struct sockaddr*)&n->second.config.routes[idx].target;
+    unsigned int prefix = 0;
+    if (sa->sa_family == AF_INET)
+        prefix = Utils::ntoh(((const struct sockaddr_in*)sa)->sin_port);
+    else if (sa->sa_family == AF_INET6)
+        prefix = Utils::ntoh(((const struct sockaddr_in6*)sa)->sin6_port);
+    else
+        return ZTS_ERR_ARG;
+    if (prefix > (sa->sa_family == AF_INET ? 32u : 128u))
+        return ZTS_ERR_ARG;
+    const size_t offset = strlen(target);
+    snprintf(target + offset, len - offset, "/%u", prefix);
+    return ZTS_ERR_OK;
+}
